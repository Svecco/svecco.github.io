---

import { profileConfig, siteConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
const fullPageBackground =
	siteConfig.banner.fullPage && siteConfig.banner.enable;
---

<!--<div class="border-t border-[var(--primary)] mx-16 border-dashed py-8 max-w-[var(--page-width)] flex flex-col items-center justify-center px-6">-->
<!--<div class="transition bg-[oklch(92%_0.01_var(--hue))] dark:bg-black rounded-2xl py-8 mt-4 mb-8 flex flex-col items-center justify-center px-6">-->
<div class={`card-base transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6 py-4 mt-4 ${fullPageBackground ? '' : ''}`}>
    <div class={`transition text-50 text-sm text-center`}>
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved. <br>
        <span class="hidden">
		Totally <span id="vercount_value_site_uv">Loading</span> Unique Visitors &&
		<span id="vercount_value_site_pv">Loading</span> Page Views <br>
        </span>
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('rss.xml')}>RSS</a> /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a> /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://astro.build">Astro</a> &
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a>
    </div>
</div>

<script is:inline defer src="https://events.vercount.one/js"></script>
