---
import { siteConfig } from "../config";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="Background">
    <div class="p-8">
        <h1 class="text-3xl font-bold mb-4">Page Background</h1>
        
        <div class="bg-white/90 dark:bg-black/90 p-6 rounded-lg backdrop-blur-sm mb-6 border border-gray-300 dark:border-gray-600">
            <h2 class="text-xl font-semibold mb-3">Configuration Status:</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <h3 class="font-medium text-lg mb-2">Banner Settings:</h3>
                    <ul class="space-y-1 text-sm">
                        <li>✅ Enabled: <span class="font-mono">{siteConfig.banner.enable.toString()}</span></li>
                        <li>✅ Full Page: <span class="font-mono">{siteConfig.banner.fullPage?.toString() || 'undefined'}</span></li>
                        <li>✅ Source Path: <span class="font-mono">{siteConfig.banner.src}</span></li>
                        <li>✅ Position: <span class="font-mono">{siteConfig.banner.position}</span></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-medium text-lg mb-2">Technical Info:</h3>
                    <ul class="space-y-1 text-sm">
                    <li>CSS Class Applied: <span id="css-class-check" class="font-mono">Checking...</span></li>
                    <li>CSS Variable Set: <span id="css-var-check" class="font-mono">Checking...</span></li>
                    <li>Image Accessible: <span id="image-check" class="font-mono">Checking...</span></li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="bg-white/80 dark:bg-black/80 p-6 rounded-lg backdrop-blur-sm mb-6">
            <h2 class="text-xl font-semibold mb-3">Troubleshooting Steps:</h2>
            <ol class="list-decimal pl-5 space-y-2">
                <li>Check browser console for JavaScript errors (F12 → Console)</li>
                <li>Verify the image loads: <a href="/assets/images/banner.webp" class="text-blue-600 hover:underline" target="_blank">View Image Directly</a></li>
                <li>Inspect element to see if <code class="bg-gray-100 dark:bg-gray-800 px-1 rounded">full-page-background</code> class is applied to <code class="bg-gray-100 dark:bg-gray-800 px-1 rounded">&lt;html&gt;</code> tag</li>
                <li>Check if CSS variable <code class="bg-gray-100 dark:bg-gray-800 px-1 rounded">--page-bg-image</code> is set in developer tools</li>
            </ol>
        </div>
        
        <div class="bg-red-100 dark:bg-red-900/30 border border-red-300 dark:border-red-700 p-4 rounded-lg">
            <h2 class="text-lg font-semibold text-red-800 dark:text-red-200 mb-2">⚠️ Known Issues:</h2>
            <p class="text-red-700 dark:text-red-300">If you see this red box, the background is not working. Please check the troubleshooting steps above.</p>
        </div>
    </div>
    
    <script>
    // Debug script to check various conditions
    document.addEventListener('DOMContentLoaded', function() {
        // Check if full-page-background class is applied
        const htmlElement = document.documentElement;
        const hasClass = htmlElement.classList.contains('full-page-background');
        
        const classCheckElement = document.getElementById('css-class-check');
        if (classCheckElement) {
            classCheckElement.textContent = hasClass ? 'YES' : 'NO';
            classCheckElement.className = hasClass ? 'font-mono text-green-600' : 'font-mono text-red-600';
        }
        
        // Check if CSS variable is set
        const bgImage = getComputedStyle(htmlElement).getPropertyValue('--page-bg-image');
        const hasVar = bgImage && bgImage.includes('url');
        
        const varCheckElement = document.getElementById('css-var-check');
        if (varCheckElement) {
            varCheckElement.textContent = hasVar ? 'YES' : 'NO';
            varCheckElement.className = hasVar ? 'font-mono text-green-600' : 'font-mono text-red-600';
        }
        
        // Check if image is accessible
        const img = new Image();
        const imageCheckElement = document.getElementById('image-check');
        
        img.onload = function() {
            if (imageCheckElement) {
                imageCheckElement.textContent = 'YES';
                imageCheckElement.className = 'font-mono text-green-600';
            }
        };
        
        img.onerror = function() {
            if (imageCheckElement) {
                imageCheckElement.textContent = 'NO';
                imageCheckElement.className = 'font-mono text-red-600';
            }
        };
        
        img.src = '/assets/images/banner.webp';
    });
    </script>
</MainGridLayout>